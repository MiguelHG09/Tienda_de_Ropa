---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/navbar';
import Footer from '../components/footer';
import '../../assets/scss/astro-ecommerce.scss';
---

<Layout title="Velora | Tu Carrito">
  <main style="background-color: #E8E4D9; color: #2C3E20; min-height: 100vh;">
    <Navbar client:load />
    
    <div class="container mt-5 mb-10">
      <h1 class="font-weight-bold mb-4" style="color: #2C3E20;">Tu Carrito de Compras</h1>
      
      <div class="row">
        <div class="col-lg-8 mb-4">
          <div id="cart-container" class="card shadow-sm border-0 p-4" style="background-color: #ffffff;">
            <p class="text-muted text-center my-5" id="empty-msg">Cargando carrito...</p>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="card shadow-sm border-0 p-4" style="background-color: #ffffff; border-top: 5px solid #4A5D23 !important;">
            <h4 class="font-weight-bold mb-4" style="color: #2C3E20;">Resumen del Pedido</h4>
            
            <div class="d-flex justify-content-between mb-3">
              <span class="text-muted">Subtotal (Sin ISV):</span>
              <span class="font-weight-bold" id="resumen-subtotal">L. 0.00</span>
            </div>
            
            <div class="d-flex justify-content-between mb-3">
              <span class="text-muted">ISV (15%):</span>
              <span class="font-weight-bold" id="resumen-isv">L. 0.00</span>
            </div>
            
            <div class="d-flex justify-content-between mb-4 border-bottom pb-3">
              <span class="text-muted">Envío:</span>
              <span class="font-weight-bold" style="color: #4A5D23;">¡Gratis!</span>
            </div>
            
            <div class="d-flex justify-content-between mb-4">
              <h5 class="font-weight-bold" style="color: #2C3E20;">Total a Pagar:</h5>
              <h5 class="font-weight-bold" id="resumen-total" style="color: #2C3E20;">L. 0.00</h5>
            </div>
            
            <button class="btn btn-lg w-100 shadow-sm" id="btn-checkout" style="background-color: #D2691E; color: white; border: none;">Proceder al Pago</button>
          </div>
        </div>
      </div>
    </div>
    
    <Footer />
  </main>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const cartContainer = document.getElementById('cart-container');
    
    function renderCart() {
      let cart = JSON.parse(localStorage.getItem('velora_cart') || '[]');
      let sumaTotal = 0; // Ahora calculamos la suma TOTAL directamente

      if (cart.length === 0) {
        if(cartContainer) cartContainer.innerHTML = '<p class="text-muted text-center my-5">Tu carrito está vacío. ¡Ve al catálogo y agrega algunas prendas!</p>';
        updateTotals(0);
        return;
      }

      let html = '';
      cart.forEach((item: any, index: number) => {
        const itemTotal = item.price * item.quantity;
        sumaTotal += itemTotal; // Sumamos al Total

        html += `
          <div class="row align-items-center border-bottom py-3">
            <div class="col-3 col-md-2 text-center">
              <img src="${item.img}" class="img-fluid rounded shadow-sm" style="max-height: 90px; object-fit: contain;" alt="${item.title}">
            </div>
            <div class="col-5 col-md-4">
              <h6 class="font-weight-bold mb-1" style="color: #2C3E20;">${item.title}</h6>
              <small class="text-muted">L. ${item.price.toFixed(2)} c/u</small>
            </div>
            <div class="col-4 col-md-3 d-flex align-items-center justify-content-center">
              <button class="btn btn-sm btn-outline-secondary px-2 py-1 mb-0 minus-btn" data-index="${index}">-</button>
              <span class="font-weight-bold mx-3">${item.quantity}</span>
              <button class="btn btn-sm btn-outline-secondary px-2 py-1 mb-0 plus-btn" data-index="${index}">+</button>
            </div>
            <div class="col-12 col-md-3 text-md-end mt-3 mt-md-0 d-flex flex-column align-items-end">
              <h6 class="font-weight-bold mb-1" style="color: #2C3E20;">L. ${itemTotal.toFixed(2)}</h6>
              <button class="btn btn-link text-danger text-sm p-0 m-0 remove-btn" data-index="${index}"><small>Eliminar</small></button>
            </div>
          </div>
        `;
      });

      if(cartContainer) cartContainer.innerHTML = html;
      updateTotals(sumaTotal); // Le pasamos la suma total incluyendo impuestos

      // Evento: boton suma (+)
      document.querySelectorAll('.plus-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const index = parseInt((e.target as HTMLButtonElement).getAttribute('data-index') || "0");
          cart[index].quantity += 1;
          localStorage.setItem('velora_cart', JSON.stringify(cart));
          renderCart(); 
        });
      });

      // Evento: boton de resta (-)
      document.querySelectorAll('.minus-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const index = parseInt((e.target as HTMLButtonElement).getAttribute('data-index') || "0");
          cart[index].quantity -= 1;
          
          if(cart[index].quantity <= 0){
            cart.splice(index, 1);
          }
          
          localStorage.setItem('velora_cart', JSON.stringify(cart));
          renderCart(); 
        });
      });

      // Evento: Eliminar directamente
      document.querySelectorAll('.remove-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const index = parseInt((e.target as HTMLButtonElement).getAttribute('data-index') || "0");
          cart.splice(index, 1);
          localStorage.setItem('velora_cart', JSON.stringify(cart));
          renderCart(); 
        });
      });
    }

    // logica de impuestos
    function updateTotals(sumaTotal: number) {
      const total = sumaTotal;
      // Fórmula para extraer el subtotal si el ISV (15%) ya está incluido
      const subtotal = total / 1.15; 
      const isv = total - subtotal;

      const elSubtotal = document.getElementById('resumen-subtotal');
      const elIsv = document.getElementById('resumen-isv');
      const elTotal = document.getElementById('resumen-total');

      if(elSubtotal) elSubtotal.innerText = `L. ${subtotal.toFixed(2)}`;
      if(elIsv) elIsv.innerText = `L. ${isv.toFixed(2)}`;
      if(elTotal) elTotal.innerText = `L. ${total.toFixed(2)}`;
    }

    renderCart();

    document.getElementById('btn-checkout')?.addEventListener('click', () => {
      let cart = JSON.parse(localStorage.getItem('velora_cart') || '[]');
      if(cart.length === 0) {
        alert("El carrito está vacío. Por favor, agrega productos primero.");
      } else {
        alert("¡Pago procesado con éxito! Gracias por elegir Velora.");
        localStorage.removeItem('velora_cart'); 
        renderCart();
      }
    });
  });
</script>